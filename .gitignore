# secrets
.env

# python
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache/
.pytest_cache/
*.egg-info/

# LLM/embedding response cache — regenerated, never hand-edited.
# NOTE: s7_delivery/cache/ (the committed replay recordings) is deliberately
# NOT ignored — those are a deliverable, committed for demo reliability.
.cache/

# per-run staging/diff artifacts — regenerated every run
s7_delivery/out/

# synthetic target-application repos, generated for testing/demo — not part of the repo
target-apps/

# Control Centre run state — recreated from seed on demand; a presenter's
# local runs are not demo material to commit
artifacts/runs/
# …and any archived-off copy of them (demo rehearsals archive rather than
# delete, and an archive is presenter state exactly like the live tree)
artifacts/runs-archive-*/

# Known-repos registry — deliberately outside artifacts/runs/ so it survives
# run deletion, but it's still local presenter state (real clone URLs from
# whoever ran the demo), not demo material to commit.
artifacts/known_repos.json
# product configuration plane (prompt sets, llm/role/user settings, audit)
# — runtime data managed by the admin app, never committed
config/

# generated data — keep the directory, not its contents

# frontend build deps — the web console landed at apps/control/web/.
# Portability rule 4 (amended 2026-08-08): apps/control/web/dist/ is
# committed, not ignored — the locked-down environment runs the built output
# directly; npm is a build-time tool only. See CLAUDE.md hard rule 4.
# Any OTHER dist/ directory in the repo stays ignored by default — the
# exception below is scoped to that one path, not to the pattern generally.
node_modules/
.vite/
dist/
!apps/control/web/dist/
!apps/admin/web/dist/

# OS / editor noise
.DS_Store
*.swp
.vscode/

# local scratch — never demo material
tmp/
output/
logs/

# reference material carrying the real client name — never commit (hard rule 2)
client-inputs-raw/

# raw call recordings, transcripts and photos. These name the real client and
# the supplier verbatim — hard rules 1 and 2 both apply. Anything needed from
# here gets rewritten to the MapleSure fiction before it lands in the repo.
callDetails/

# another team's internal material, held locally for reference only — never
# commit. Ideas may be borrowed; their documents, wording, figures and measured
# numbers do not ship here. Keep all such material under this one neutral path:
# a folder named after the team would leak the team name into this file.
reference-internal/

# Subagent-driven-development scratch — ledgers, task briefs, review
# packages. Per-plan working state, not a deliverable; git history is the
# record once a plan finishes.
.superpowers/
.worktrees/
EpicFromClient/

# Expo nomination material — photos of internal (TCS-Confidential) email
# chains with real names and addresses. Reference only; never commit.
Expo/
